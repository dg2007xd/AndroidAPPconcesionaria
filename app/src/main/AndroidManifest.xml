<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectoLoki">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".screens.DetalleActivity" android:exported="false" />
        <activity
            android:name=".EmpezarActivity"
            android:exported="false"
            android:label="@string/title_activity_empezar"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TerminosActivity"
            android:exported="false"
            android:label="@string/title_activity_terminos"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:label="@string/title_activity_dashboard"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.PerfilActivity"
            android:exported="false"
            android:label="@string/title_activity_perfil"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.tienda.TiendaActivity"
            android:exported="false"
            android:label="Tienda"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".screens.proveedores.ProveedoresActivity"
            android:exported="false"
            android:label="@string/title_activity_proveedores"
            android:theme="@style/Theme.ProyectoLoki"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>